{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strassentrainer.de/schemas/dataset-package.schema.json",
  "title": "Straßentrainer Dataset Package Schema",
  "description": "Normatives JSON-Schema für Straßentrainer-Trainingsdatenpakete (Schema 1).",
  "type": "object",
  "required": [
    "schemaVersion",
    "city",
    "boundary",
    "streets",
    "pois"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Strukturelle Version des Package-Formats. Aktuell fixiert auf 1."
    },
    "exportedAt": {
      "type": "string",
      "description": "ISO-8601-Zeitstempel der Serialisierung/des Exports."
    },
    "package": {
      "type": "object",
      "description": "Paketidentität und Veröffentlichungsmetadaten.",
      "required": [
        "id",
        "type",
        "version",
        "contentHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-_.]*$",
          "maxLength": 120,
          "description": "Eindeutige Paket-ID (z. B. 'de-nw-olpe' oder 'de-oberasbach-fire-training')."
        },
        "type": {
          "type": "string",
          "enum": ["curated", "osm", "imported"],
          "description": "Kurationsstatus bzw. Pakettyp."
        },
        "datasetKind": {
          "type": "string",
          "enum": ["municipality", "city", "district", "custom", "curated"],
          "default": "municipality",
          "description": "Geografische/administrative Klassifikation des Datensatzes."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?$",
          "description": "Dataset-Veröffentlichungsversion im SemVer- oder CalVer-Format (z. B. '1.0.0' oder '2026.09.05')."
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Menschenlesbarer Titel des Datenpakets."
        },
        "createdAt": {
          "type": "string",
          "description": "Erstellungszeitpunkt der Paketversion (ISO-8601)."
        },
        "updatedAt": {
          "type": "string",
          "description": "Letzter Änderungszeitpunkt der Paketversion (ISO-8601)."
        },
        "source": {
          "type": "string",
          "description": "Herkunftsbezeichnung (z. B. 'curated', 'osm-pbf')."
        },
        "verification": {
          "type": "object",
          "description": "Optionale redaktionelle Prüfmetadaten (keine kryptografische Signatur).",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["verified", "unverified"]
            },
            "verifiedAt": {
              "type": "string"
            },
            "maintainer": {
              "type": "string",
              "maxLength": 120
            },
            "note": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": ["status"]
        },
        "contentHash": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-f]{64}$",
          "description": "Deterministischer SHA-256-Inhaltshash des Datensatzes."
        }
      },
      "additionalProperties": true
    },
    "city": {
      "type": "object",
      "description": "Administrative Metadaten der Gemeinde/Stadt.",
      "required": [
        "id",
        "name",
        "osmType",
        "osmId",
        "bounds",
        "center"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Kanonische Identität der Stadt (z. B. 'osm-relation-163179')."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Offizieller Gemeindename."
        },
        "displayName": {
          "type": "string",
          "description": "Anzeigename."
        },
        "district": {
          "type": ["string", "null"],
          "description": "Landkreis oder kreisfreie Stadt."
        },
        "state": {
          "type": ["string", "null"],
          "description": "Bundesland (z. B. 'Nordrhein-Westfalen')."
        },
        "country": {
          "type": ["string", "null"],
          "description": "Staat (z. B. 'Deutschland')."
        },
        "postalCodes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "osmType": {
          "type": "string",
          "enum": ["relation"]
        },
        "osmId": {
          "type": "integer",
          "minimum": 1
        },
        "adminLevel": {
          "type": ["integer", "null"]
        },
        "officialMunicipalityKey": {
          "type": ["string", "null"]
        },
        "regionalKey": {
          "type": ["string", "null"]
        },
        "bounds": {
          "type": "object",
          "required": ["south", "west", "north", "east"],
          "properties": {
            "south": { "type": "number", "minimum": -90, "maximum": 90 },
            "west": { "type": "number", "minimum": -180, "maximum": 180 },
            "north": { "type": "number", "minimum": -90, "maximum": 90 },
            "east": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "center": {
          "type": "object",
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "defaultZoom": {
          "type": ["integer", "null"]
        },
        "streetCount": {
          "type": "integer",
          "minimum": 1
        },
        "poiCount": {
          "type": "integer",
          "minimum": 0
        },
        "hasAreas": {
          "type": "boolean"
        },
        "areaCount": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "boundary": {
      "type": "object",
      "description": "Administrative Außengrenze der Stadt (GeoJSON Polygon oder MultiPolygon).",
      "required": ["type", "coordinates"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["Polygon", "MultiPolygon"]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "streets": {
      "type": "array",
      "minItems": 1,
      "description": "Liste aller spielbaren Straßen im Stadtgebiet.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cityId",
          "name",
          "geometry",
          "osmWayIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cityId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "type": "string", "const": "MultiLineString" },
              "coordinates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 3,
                    "items": { "type": "number" }
                  }
                }
              }
            }
          },
          "osmWayIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 1 }
          }
        },
        "additionalProperties": true
      }
    },
    "pois": {
      "type": "array",
      "description": "Liste aller einsatzrelevanten Points of Interest.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "cityId",
          "name",
          "category"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cityId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": ["object", "null"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 }
            },
            "required": ["lat", "lon"]
          },
          "geometry": {
            "type": ["object", "null"],
            "properties": {
              "type": { "type": "string", "enum": ["Polygon", "MultiPolygon"] },
              "coordinates": { "type": "array" }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "areas": {
      "type": "array",
      "description": "Optionale administrative Untergebiete (TrainingAreas).",
      "items": {
        "type": "object",
        "required": ["id", "cityId", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "cityId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "parentId": { "type": ["string", "null"] },
          "tier": { "type": ["integer", "null"] },
          "adminLevel": { "type": ["integer", "null"] },
          "bounds": { "type": ["object", "null"] },
          "geometry": {
            "type": "object",
            "required": ["type", "coordinates"],
            "properties": {
              "type": { "type": "string", "enum": ["Polygon", "MultiPolygon"] },
              "coordinates": { "type": "array" }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "categories": {
      "type": "array",
      "description": "Optionale POI-Kategoriendefinitionen für das Paket."
    },
    "provenance": {
      "type": "object",
      "description": "Herkunfts- und Bauprovenienz der Daten.",
      "required": ["source"],
      "properties": {
        "source": { "type": "string" },
        "osmRelationId": { "type": "integer" },
        "municipalityRelation": { "type": "integer" },
        "osmDataTimestamp": { "type": "string" },
        "builderVersion": { "type": "string" },
        "generatedAt": { "type": "string" },
        "sourcePbf": {
          "type": "string",
          "pattern": "^[^/\\\\]+$",
          "description": "Reiner Dateiname ohne absolute Pfadangaben."
        },
        "sourceRegion": { "type": "string" },
        "municipalityKey": { "type": "string" }
      },
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "description": "Optionale Build- und Diagnoseinformationen.",
      "properties": {
        "warnings": {
          "type": "array",
          "description": "Nicht-fatale Warnungen aus dem Erzeugungsprozess.",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "severity": { "type": "string", "enum": ["warning", "info", "error"] },
              "message": { "type": "string" },
              "entityType": { "type": "string" },
              "entityIds": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

