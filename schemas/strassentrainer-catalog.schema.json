{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strassentrainer.de/schemas/dataset-catalog.schema.json",
  "title": "Straßentrainer Dataset Catalog Schema",
  "description": "Normatives JSON-Schema für den Straßentrainer-Dataset-Katalog (Schema 1).",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "datasets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Strukturelle Version des Katalogformats. Aktuell fixiert auf 1."
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO-8601-Zeitstempel der Katalogerzeugung."
    },
    "datasets": {
      "type": "array",
      "description": "Liste der indizierten Trainingsdatensätze.",
      "items": {
        "$ref": "#/$defs/catalogDatasetEntry"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "catalogDatasetEntry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "displayName",
        "datasetKind",
        "state",
        "country",
        "cityId",
        "version",
        "contentHash",
        "streetCount",
        "poiCount",
        "areaCount",
        "center",
        "bounds",
        "downloadPath",
        "fileSize"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-_.]*$",
          "maxLength": 120,
          "description": "Eindeutige Paket-/Dataset-ID (entspricht package.id)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Gemeindename."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Anzeigename der Gemeinde."
        },
        "datasetKind": {
          "type": "string",
          "enum": ["municipality", "city", "district", "custom", "curated"],
          "default": "municipality",
          "description": "Geografische Gebietsklassifikation. Standard ist 'municipality'."
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Bundesland."
        },
        "district": {
          "type": ["string", "null"],
          "maxLength": 80,
          "description": "Landkreis oder Bezirk, falls zutreffend."
        },
        "country": {
          "type": "string",
          "default": "Deutschland",
          "maxLength": 80,
          "description": "Land der Gebietskörperschaft."
        },
        "postalCodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Postleitzahlen der Gebietskörperschaft."
        },
        "cityId": {
          "type": "string",
          "pattern": "^osm-(relation|way|node)-\\d+$",
          "description": "Geografische OSM-Identität der Stadt (entspricht city.id)."
        },
        "osmType": {
          "type": "string",
          "enum": ["relation", "way", "node"],
          "description": "OSM-Elementtyp der Gebietsrelation."
        },
        "osmRelationId": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "OSM-Relations-ID der Gebietsbegrenzung."
        },
        "packageType": {
          "type": "string",
          "enum": ["curated", "osm", "imported"],
          "description": "Kurationsstatus des Datenpakets."
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:\\.\\d+)?$",
          "description": "Veröffentlichungsversion im SemVer- oder CalVer-Format."
        },
        "contentHash": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-f]{64}$",
          "description": "Deterministischer SHA-256-Inhaltshash des Datenpakets."
        },
        "streetCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Anzahl der enthaltenen spielbaren Straßen."
        },
        "poiCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Anzahl der enthaltenen POIs."
        },
        "areaCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Anzahl der enthaltenen Trainingsgebiete."
        },
        "center": {
          "type": "object",
          "required": ["lat", "lon"],
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "additionalProperties": false,
          "description": "Geografisches Zentrum für die Kartenzentrierung."
        },
        "bounds": {
          "type": "object",
          "required": ["south", "west", "north", "east"],
          "properties": {
            "south": { "type": "number", "minimum": -90, "maximum": 90 },
            "west": { "type": "number", "minimum": -180, "maximum": 180 },
            "north": { "type": "number", "minimum": -90, "maximum": 90 },
            "east": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "additionalProperties": false,
          "description": "Geografische Bounding-Box der Gemeinde."
        },
        "downloadPath": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[a-zA-Z0-9_.-]+(/[a-zA-Z0-9_.-]+)*\\.json$",
          "description": "Sicherer, relativer, portabler Download-Pfad zum JSON-Paket."
        },
        "fileSize": {
          "type": "integer",
          "minimum": 1,
          "description": "Dateigröße des Package-JSON-Artefakts in Bytes."
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Optionaler menschlicher Titel des Datenpakets."
        },
        "source": {
          "type": "string",
          "maxLength": 120,
          "description": "Optionale Quellenbezeichnung des Pakets."
        }
      },
      "additionalProperties": false
    }
  }
}

